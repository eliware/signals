{
  "name": "@eliware/signals",
  "type": "module",
  "version": "1.1.2",
  "description": "Graceful shutdown signal handler utility for Node.js (ESM and CommonJS)",
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "files": [
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.cjs",
      "types": "./index.d.ts"
    }
  },
  "scripts": {
    "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles --silent --coverage",
    "test:gaps": "npm test -- --coverageReporters=text 2>&1 | awk '!/100%/'",
    "test:gaps": "npm test -- --coverageReporters=text 2>&1 | awk '!/100%/'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/signals.git"
  },
  "keywords": [
    "nodejs",
    "signals",
    "shutdown",
    "graceful shutdown",
    "process",
    "handler",
    "utility",
    "esm",
    "commonjs",
    "cjs",
    "package",
    "library",
    "npm",
    "node",
    "logger"
  ],
  "author": "Eli Sterling, eliware.org <eli@eliware.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eliware/signals/issues"
  },
  "homepage": "https://github.com/eliware/signals#readme",
  "devDependencies": {
    "jest": "^30.4.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/?(*.)+(spec|test).[jt]s?(x)",
      "**/?(*.)+(spec|test).mjs",
      "**/?(*.)+(spec|test).cjs"
    ]
  },
  "dependencies": {
    "@eliware/log": "^1.1.4"
  }
}
