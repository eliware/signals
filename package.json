{
    "name": "@eliware/signals",
    "type": "module",
    "version": "2.0.0",
    "engines": {
        "node": ">=26"
    },
    "description": "Graceful shutdown signal handler utility for Node.js",
    "types": "index.d.ts",
    "files": [
        "index.mjs",
        "index.d.ts",
        "README.md",
        "RELEASE_NOTES.md",
        "LICENSE",
        "examples"
    ],
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.mjs"
        }
    },
    "scripts": {
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/signals.git"
    },
    "keywords": [
        "nodejs",
        "signals",
        "shutdown",
        "graceful shutdown",
        "process",
        "handler",
        "utility",
        "esm",
        "package",
        "library",
        "npm",
        "node",
        "logger",
        "abort-signal"
    ],
    "author": "Eli Sterling, eliware.org <eli@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/signals/issues"
    },
    "homepage": "https://github.com/eliware/signals#readme",
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@eliware/test": "^2.0.0",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@eliware/log": "^2.0.0"
    }
}
